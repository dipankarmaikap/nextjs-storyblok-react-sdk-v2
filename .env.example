# ─────────────────────────────────────────────────────────────────────────────
# Environment variables
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env.local
# 2. Fill in your values below
# 3. Never commit .env.local — it is gitignored
#
# Find your tokens at: https://app.storyblok.com → My Account → Access Tokens
# ─────────────────────────────────────────────────────────────────────────────


# Management API token
# Used by CLI scripts and migrations — never exposed to the browser.
# Scope: "Full Access" or limit to the spaces you need.
STORYBLOK_MAPI_TOKEN=sb_pat_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Delivery API token
# Used at runtime to fetch story content. Prefixed NEXT_PUBLIC_ so the
# browser SDK can read it — use a "Public" token, not a preview token.
NEXT_PUBLIC_STORYBLOK_DELIVERY_API_TOKEN=xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Storyblok region where your space is hosted — eu | us | ap | ca
# Must match the region shown in your space settings.
NEXT_PUBLIC_STORYBLOK_REGION=eu

# Deployment mode — controls draft content and the preview banner.
#
#   preview    → fetches draft stories, shows the in-app preview banner,
#                disables caching so editors always see their latest changes.
#                Set this on your preview / staging deployment only.
#
#   (unset)    → fetches published stories with full caching enabled.
#                This is the default for production.
STORYBLOK_ENV=preview
